# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (defaults to /var/lib/jnl-bot/data/finance_bot.db on Linux VPS)
DATABASE_URL=sqlite+aiosqlite:////var/lib/jnl-bot/data/finance_bot.db

# Backup Directory
BACKUP_DIR=/var/backups/jnl-bot

# Embedded WebApp Server Settings (bound to 127.0.0.1:8095 so it never conflicts with ports 80/443/8080)
# Set WEBAPP_PORT=0 to disable the embedded HTTP server completely
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=0
WEBAPP_URL=

# Independent Cloud Backup (S3-compatible: AWS S3, Cloudflare R2, MinIO, Yandex Cloud)
S3_BACKUP_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=us-east-1
S3_ENCRYPTION_KEY=
S3_RETENTION_DAYS=30
