# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (defaults to local SQLite database inside ./data/finance_bot.db)
DATABASE_URL=sqlite+aiosqlite:///./data/finance_bot.db

# Embedded WebApp Server Settings (bound to 127.0.0.1:8095 so it never conflicts with ports 80/443/8080)
# Set WEBAPP_PORT=0 to disable the embedded HTTP server completely
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8095
WEBAPP_URL=
