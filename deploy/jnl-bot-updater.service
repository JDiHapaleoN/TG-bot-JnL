[Unit]
Description=JnL-Bot Controlled Updater Service (Requires jnl-bot.service to be stopped first)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jnl-bot
Group=jnl-bot
WorkingDirectory=/opt/jnl-bot
EnvironmentFile=/var/lib/jnl-bot/.env
ExecStart=/opt/jnl-bot/deploy/auto_update.sh
StandardOutput=journal
StandardError=journal

# Security Hardening & Sandboxing (No sudo, no root privileges)
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=

# ReadWritePaths needed for code update, dependencies, data and backups
ReadWritePaths=/opt/jnl-bot /var/lib/jnl-bot/data /var/lib/jnl-bot/backups
ReadOnlyPaths=/var/lib/jnl-bot/.env
InaccessiblePaths=-/home -/var/www -/root -/usr/local/hestia -/etc/nginx -/etc/apache2 -/etc/php -/var/log/nginx -/var/log/apache2 -/var/log/hestia
